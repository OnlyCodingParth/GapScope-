APP_ENV=local
FRONTEND_ORIGIN=http://localhost:5173

# Phase 4 Google Identity Services client ID (not secret).
GOOGLE_CLIENT_ID=
# Session duration in seconds. Sessions are opaque, server-side records.
SESSION_TTL_SECONDS=28800
# Set true when HTTPS is enabled in production; leave false for local HTTP.
COOKIE_SECURE=false
SESSION_SECRET=
# Phase 7: backend-only Gemini configuration. Leave blank to use deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=12
